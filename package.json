{
  "name": "testdriller-cbt-suite",
  "version": "1.0.0",
  "private": true,
  "description": "CBT suite for JAMB, WAEC, Post-UTME, NCEE and BECE",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "test:engine": "node scripts/auto-test-engine.js",
    "build": "npm --prefix client run build"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
